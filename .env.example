# ═══════════════════════════════════════════════════════════════════════════════
# BARC Pipeline — Deployment mode
# ═══════════════════════════════════════════════════════════════════════════════
# Set MODE to LOCAL or RUNPOD. All start/teardown/test scripts read this file.
#   LOCAL  — Run all model servers on local GPU(s) via Docker
#   RUNPOD — Run all model servers on RunPod cloud GPUs
#
# When MODE=RUNPOD, you must also export HF_TOKEN before deploying:
#   export HF_TOKEN=hf_...
# ═══════════════════════════════════════════════════════════════════════════════
MODE=LOCAL
HF_TOKEN=

# Master RAG toggle — all services read this
# Set to false to disable RAG context injection, knowledge tools, and ingestion
RAG_ENABLED=true

# Image OCR: none | basic (Tesseract) | paddleocr. In RunPod mode the model
# endpoint is loaded from models/.env.runpod; local mode uses in-process PaddleOCR.
OCR_MODE=paddleocr
OCR_BASE_URL=
OCR_API_KEY=dummy
OCR_MODEL=PaddlePaddle/PaddleOCR-VL-1.6
OCR_MAX_IMAGE_HEIGHT=2400
