# ── Mock environment for local development (no real GPUs needed) ────────────
# All model endpoints point at the stdlib-only mock server on ports 9000-9003.
# Uses SQLite for simplicity (override to PostgreSQL if needed).
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=mock-test-key-not-for-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

MEDIA_ROOT=./media
STATIC_ROOT=./staticfiles

# Chat model endpoint → mock server
CHAT_BASE_URL=http://localhost:9000/v1
CHAT_API_KEY=mock

# Embedding model endpoint → mock server
EMBEDDING_BASE_URL=http://localhost:9001/v1
EMBEDDING_API_KEY=mock

# Reranker endpoint → mock server
RERANKER_BASE_URL=http://localhost:9003
RERANKER_API_KEY=mock

# Mock model names
CHAT_MODEL=openai/mock-chat
VISION_MODEL=openai/mock-chat
TEXT_EMBEDDING_MODEL=openai/mock-text-embed
TEXT_EMBEDDING_DIM=768
MULTIMODAL_EMBEDDING_MODEL=openai/mock-multimodal-embed
MULTIMODAL_EMBEDDING_DIM=512
RERANKER_MODEL=mock-reranker

# Milvus (set to localhost for mock testing)
MILVUS_HOST=localhost
MILVUS_PORT=19530

CHAT_CONTEXT_MAX_TOKENS=2048
CHAT_CONTEXT_MAX_TOKENS_LARGE=4096
CHAT_RESPONSE_MAX_TOKENS=1024
CHAT_COMPACTION_THRESHOLD_TOKENS=14000
CHAT_STREAMING_ENABLED=true

# RAG — enabled by default in mock mode (points at rag-pipeline mock)
# Set model endpoints: the start-services-no-gemma.sh overrides these with
# the correct Docker gateway IP or container names for the mock servers.
RAG_ENABLED=true
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.0

# RAG Pipeline API — send uploads to mock RAG API for async processing
RAG_API_ENABLED=true
RAG_API_BASE_URL=http://localhost:8093
RAG_API_TIMEOUT=300

MAX_UPLOAD_MB=50
INGESTION_SYNC=true
KNOWLEDGE_DEFAULT_VISIBILITY=private
MEMORY_AUTO_SAVE_DEFAULT=false

TOOL_CALLS_ENABLED=false
TOOL_CALL_TIMEOUT_SECONDS=10
TOOL_RESULT_MAX_TOKENS=500
