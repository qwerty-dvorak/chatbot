# ═══════════════════════════════════════════════════════════════════════════════
# Chatbot Service — environment variables
# ═══════════════════════════════════════════════════════════════════════════════
#
# Deployment topology choices:
#
#  Profile A: Standalone (no RAG pipeline) — all models local or RunPod
#    RAG_API_ENABLED=false
#    Chat uses its own LLM endpoint.
#    (Deprecated; prefer Profile B or C.)
#
#  Profile B: Rag-pipeline as remote API — RECOMMENDED for two-server deploy
#    RAG_API_ENABLED=true
#    RAG_API_BASE_URL=http://<rag-server>:8093
#    POSTGRES_HOST=<rag-server> or <db-server>
#    Document ingestion + search handled by rag-pipeline via HTTP API.
#    Chatbot-service only does chat, memory, tool calling.
#    PostgreSQL is shared with the rag-pipeline server.
#
#  Profile C: All local / mock (development)
#    RAG_API_ENABLED=false (or points to local rag-api)
#    CHAT_BASE_URL, EMBEDDING_BASE_URL, RERANKER_BASE_URL → local mock/vLLM
#    MILVUS_HOST=localhost (or test-milvus in Docker)
#
# ── Django ──────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

MEDIA_ROOT=./media
STATIC_ROOT=./staticfiles

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# Shared with rag-pipeline. Must be the same database for both services.
# For two-server deploy:
#   HOST = IP of the server running PostgreSQL (or a managed DB endpoint)
#   Ensure PostgreSQL listens externally:
#     postgresql.conf → listen_addresses = '*'
#     pg_hba.conf     → host chatbot chatbot <web-server-ip>/32 md5
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Chat / LLM endpoint ────────────────────────────────────────────────────
# The LLM that powers the chatbot conversation.
# Can be the same or different from the RAG pipeline's CHAT_BASE_URL.
# RunPod: https://<pod-id>-8000.proxy.runpod.net/v1
# Local:  http://gemma-inference-server:8000/v1
CHAT_BASE_URL=http://localhost:9000/v1
CHAT_API_KEY=local-placeholder
CHAT_MODEL=openai/google/gemma-4-E4B-it
VISION_MODEL=openai/google/gemma-4-E4B-it
# Comma-separated vLLM module names, generated by the model deployment scripts.
LORA_ADAPTERS=

# ── Embedding endpoint ──────────────────────────────────────────────────────
# Used for user memory embeddings (not for document RAG unless running
# standalone without rag-pipeline).
EMBEDDING_BASE_URL=http://localhost:9000/v1
EMBEDDING_API_KEY=local-placeholder
TEXT_EMBEDDING_MODEL=openai/mock-embed
TEXT_EMBEDDING_DIM=64
MULTIMODAL_EMBEDDING_MODEL=openai/mock-embed
MULTIMODAL_EMBEDDING_DIM=64

# ── Reranker endpoint ───────────────────────────────────────────────────────
RERANKER_BASE_URL=http://localhost:9000/v1
RERANKER_API_KEY=local-placeholder
RERANKER_MODEL=openai/mock-reranker

# ── Milvus ──────────────────────────────────────────────────────────────────
# For user memory storage (document vectors live on the RAG pipeline's Milvus).
# SHARED Milvus instance preferred so both services see the same collections.
# Single-server: MILVUS_HOST=test-milvus (Docker network)
# Two-server:    MILVUS_HOST=<rag-server-ip> (same Milvus as rag-pipeline)
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ── RAG Pipeline Integration ────────────────────────────────────────────────
# Route all document ingest + search to the standalone rag-pipeline API.
# RAG_ENABLED is set in root .env (master toggle) — not here.
RAG_API_ENABLED=false
RAG_API_BASE_URL=http://localhost:8093

# RAG search behaviour (hybrid search + optional reranker)
RAG_TOP_K=8
RAG_MIN_SIMILARITY=0.45

# ── Chat context / streaming ────────────────────────────────────────────────
CHAT_CONTEXT_MAX_TOKENS=32000
CHAT_CONTEXT_MAX_TOKENS_LARGE=256000
CHAT_RESPONSE_MAX_TOKENS=2048
CHAT_COMPACTION_THRESHOLD_TOKENS=14000
CHAT_STREAMING_ENABLED=true

# ── Chunking (standalone mode only — ignored when RAG_API_ENABLED=true) ─────
RAG_CHUNK_TARGET_TOKENS=700
RAG_CHUNK_OVERLAP_TOKENS=120

# ── Upload / visibility ─────────────────────────────────────────────────────
MAX_UPLOAD_MB=50
INGESTION_SYNC=false
KNOWLEDGE_DEFAULT_VISIBILITY=private
MEMORY_AUTO_SAVE_DEFAULT=true

# ── Tool calling ────────────────────────────────────────────────────────────
TOOL_CALLS_ENABLED=true
TOOL_CALL_TIMEOUT_SECONDS=60
TOOL_RESULT_MAX_TOKENS=4000
