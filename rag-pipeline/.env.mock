# ── Mock environment for local integration testing ──────────────────────────
# Points all model endpoints at the stdlib-only mock server (ports 9000-9003).
# Milvus runs locally on the default port.
#
# Usage:
#   bash start-mock-server.sh
#   bash runpod_start_local_milvus.sh
#   cp .env.mock .env && bash start-services.sh
#   bash test_api.sh

# ── Chat endpoint (mock) ────────────────────────────────────────────────────
CHAT_BASE_URL=http://localhost:9000/v1
CHAT_API_KEY=mock
CHAT_MODEL=openai/mock-chat

# ── Text embedding endpoint (mock) ──────────────────────────────────────────
EMBEDDING_BASE_URL=http://localhost:9001/v1
EMBEDDING_API_KEY=mock
TEXT_EMBEDDING_MODEL=openai/mock-text-embed
TEXT_EMBEDDING_DIM=768

# ── Multimodal embedding endpoint (mock) ────────────────────────────────────
MULTIMODAL_EMBEDDING_BASE_URL=http://localhost:9002/v1
MULTIMODAL_EMBEDDING_API_KEY=mock
MULTIMODAL_EMBEDDING_MODEL=openai/mock-multimodal-embed
MULTIMODAL_EMBEDDING_DIM=512

# ── Reranker endpoint (mock) ────────────────────────────────────────────────
RERANKER_BASE_URL=http://localhost:9003
RERANKER_API_KEY=mock
RERANKER_MODEL=mock-reranker

# ── Milvus (local) ──────────────────────────────────────────────────────────
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ── Collections ─────────────────────────────────────────────────────────────
TEXT_COLLECTION=rag_text_chunks_mock
IMAGE_COLLECTION=rag_image_chunks_mock

# ── BM25 ────────────────────────────────────────────────────────────────────
BM25_INDEX_PATH=./bm25_index_mock.pkl

# ── Chunking ────────────────────────────────────────────────────────────────
CHUNK_STRATEGY=recursive
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Retrieval ───────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
HYBRID_ALPHA=0.5

# ── Query enhancements (disabled for mock testing) ──────────────────────────
QUERY_ENHANCEMENTS=
