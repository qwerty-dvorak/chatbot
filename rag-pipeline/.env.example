# ═══════════════════════════════════════════════════════════════════════════════
# RAG Pipeline — environment variables
# ═══════════════════════════════════════════════════════════════════════════════
#
# Deployment topologies:
#
#   A) Single-server (dev / small-scale):
#      Everything runs on one machine. PostgreSQL, Milvus, and the RAG API
#      container communicate over a Docker network (e.g. `rag_net`).
#
#   B) Two-server (production-scale):
#      Server 1 (RAG server):  rag-api + Milvus + PostgreSQL + RunPod endpoints
#      Server 2 (Chat server): chatbot-service Django app
#      Both servers share the same PostgreSQL database.
#      The chatbot-service connects to rag-api via RAG_API_BASE_URL for search.
#
# ── LLM endpoint (chat completions) ────────────────────────────────────────────
# Used by query.py for HyDE generation, sub-queries, stepback, and
# hypothetical question generation at index time.
# Can be a local vLLM server, RunPod proxy, or mock.
CHAT_BASE_URL=http://localhost:9000/v1
CHAT_API_KEY=mock
CHAT_MODEL=openai/mock-chat



# ── Text embedding endpoint ───────────────────────────────────────────────────
EMBEDDING_BASE_URL=http://localhost:9001/v1
EMBEDDING_API_KEY=mock
TEXT_EMBEDDING_MODEL=nvidia/llama-embed-nemotron-8b
TEXT_EMBEDDING_DIM=4096

# ── Multimodal embedding endpoint ──────────────────────────────────────────────
MULTIMODAL_EMBEDDING_BASE_URL=http://localhost:9002
MULTIMODAL_EMBEDDING_API_KEY=mock
MULTIMODAL_EMBEDDING_MODEL=nvidia/nemotron-colembed-vl-8b-v2
MULTIMODAL_EMBEDDING_DIM=4096

# ── Reranker endpoint ─────────────────────────────────────────────────────────
# Uses POST /score (preferred) or falls back to POST /v1/rerank.
# RunPod: https://<pod-id>-8000.proxy.runpod.net  (no /v1 prefix)
RERANKER_BASE_URL=http://localhost:9003
RERANKER_API_KEY=mock
RERANKER_MODEL=Qwen/Qwen3-VL-Reranker-2B

# ── OCR endpoint ────────────────────────────────────────────────────────────
# PaddleOCR-VL-1.6 via POST /v1/chat/completions.
# OCR_MODE choices: none | basic (Tesseract) | paddleocr.
# Leave OCR_BASE_URL empty for local in-process PaddleOCR.
OCR_MODE=paddleocr
OCR_BASE_URL=
OCR_API_KEY=mock
OCR_MODEL=PaddlePaddle/PaddleOCR-VL-1.6
OCR_PDF_DPI=150
OCR_MAX_IMAGE_HEIGHT=2400
OCR_LANGUAGES=eng

# ── Milvus ─────────────────────────────────────────────────────────────────────
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ── Collections ───────────────────────────────────────────────────────────────
TEXT_COLLECTION=rag_text_chunks
IMAGE_COLLECTION=rag_image_chunks

# ── BM25 ───────────────────────────────────────────────────────────────────────
BM25_INDEX_PATH=./data/bm25_index.pkl

# ── Durable ingestion queue ───────────────────────────────────────────────────
INGESTION_DATA_DIR=./data/ingestion
INGESTION_POLL_INTERVAL=0.5

# ── Chunking ──────────────────────────────────────────────────────────────────
# Default strategy — overridden per tier (instant=recursive, slow=sentence_window).
CHUNK_STRATEGY=recursive
CHUNK_SIZE=512
CHUNK_OVERLAP=64
SENTENCE_WINDOW_SIZE=3     # sentences before/after for sentence_window strategy
PARENT_CHUNK_SIZE=2048     # parent chunk size for recursive/hierarchical strategies

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
HYBRID_ALPHA=0.5           # 0.0=pure BM25, 1.0=pure vector (weighted RRF)

# ── Query enhancement ─────────────────────────────────────────────────────────
# Comma-separated list: hyde,sub_queries,stepback.
# Overridable per-request via API body flags (hyde, sub_queries, stepback).
QUERY_ENHANCEMENTS=hyde

# Number of fake answer documents to generate per query for HyDE.
HYDE_N_DOCUMENTS=2

# Number of sub-questions to generate per query for sub-query decomposition.
SUB_QUERIES_COUNT=2

# ── Hypothetical questions (index-time query augmentation) ────────────────────
# Each chunk generates N questions → each question is embedded as a separate
# vector in Milvus (chunk_type='hypothetical_question') with parent_id pointing
# to the source chunk. At search time, query-to-query matching resolves hits
# back to source chunks.
# instant=0 (disabled), slow=2.
HYPOTHETICAL_QUESTIONS_PER_CHUNK=3

# ── Hierarchical Index (coarse-to-fine retrieval) ────────────────────────────
# When enabled, search first matches against document summary vectors to
# identify relevant documents, then searches only within those documents'
# chunks.  This reduces noise in large document collections.
HIERARCHICAL_MODE=true
# How many summary matches to retrieve in stage 1 of hierarchical search.
SUMMARY_TOP_K=3
# Generate a summary for each ingested document and index it as a SUMMARY
# vector in Milvus.  Disable to skip the extra LLM call during ingestion.
GENERATE_SUMMARY=true

# ── PostgreSQL knowledge store ─────────────────────────────────────────────────
# Unique database shared with the chatbot-service Django app.
# All tables (knowledge_sources, documents, document_chunks, document_assets)
# are managed by Django migrations in chatbot-service/apps/knowledge/.
#
# Single-server (inside Docker network):
#   POSTGRES_HOST=rag-postgres
# Two-server (remote DB):
#   POSTGRES_HOST=<db-server-ip>
#   Ensure PostgreSQL listens on 0.0.0.0:
#     postgresql.conf:  listen_addresses = '*'
#     pg_hba.conf:      host chatbot chatbot <rag-server-ip>/32 md5
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_POOL_SIZE=5

# ── Object store (raw document bytes) ─────────────────────────────────────────
# File-system backed content-addressed store (SHA-256 keyed).
OBJECT_STORE_PATH=./data/object_store
