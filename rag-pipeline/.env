# RunPod endpoints — current deployment
# Milvus runs locally via Docker containers

# Chat — google/gemma-4-E4B-it on RTX 4090 ($0.29/hr)
CHAT_BASE_URL=https://hcntq5ybu0vprw-8000.proxy.runpod.net/v1
CHAT_API_KEY=dummy
CHAT_MODEL=openai/google/gemma-4-E4B-it

# Text embedding — nvidia/llama-embed-nemotron-8b  (L4 24GB, $0.39/hr)
EMBEDDING_BASE_URL=https://58nywme1sylc1f-8000.proxy.runpod.net/v1
EMBEDDING_API_KEY=dummy
TEXT_EMBEDDING_MODEL=nvidia/llama-embed-nemotron-8b
TEXT_EMBEDDING_DIM=4096

# Multimodal embedding — nvidia/nemotron-colembed-vl-8b-v2 (RTX 3090, $0.22/hr)
MULTIMODAL_EMBEDDING_BASE_URL=https://8xg0h6qi246495-8000.proxy.runpod.net
MULTIMODAL_EMBEDDING_API_KEY=dummy
MULTIMODAL_EMBEDDING_MODEL=nvidia/nemotron-colembed-vl-8b-v2
MULTIMODAL_EMBEDDING_DIM=4096

# Reranker — Qwen/Qwen3-VL-Reranker-2B (RTX 3090, $0.22/hr)
RERANKER_BASE_URL=https://pitd4cscm544u2-8000.proxy.runpod.net
RERANKER_API_KEY=dummy
RERANKER_MODEL=Qwen/Qwen3-VL-Reranker-2B

# PostgreSQL (Docker network)
POSTGRES_HOST=rag-postgres

# Milvus (local Docker)
MILVUS_HOST=standalone
MILVUS_PORT=19530

# Collections
TEXT_COLLECTION=rag_text_chunks
IMAGE_COLLECTION=rag_image_chunks

# BM25
BM25_INDEX_PATH=./data/bm25_index.pkl

# Chunking
CHUNK_STRATEGY=recursive
CHUNK_SIZE=512
CHUNK_OVERLAP=64
SENTENCE_WINDOW_SIZE=3
PARENT_CHUNK_SIZE=2048

# Retrieval
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
HYBRID_ALPHA=0.5

# Query enhancements — uses RunPod Gemma chat pod for HyDE generation
QUERY_ENHANCEMENTS=hyde

HYPOTHETICAL_QUESTIONS_PER_CHUNK=3
